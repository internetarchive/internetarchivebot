{
  "config": {
      "platform": {
          "php": "7.4.3"
      },
      "allow-plugins": {
          "php-http/discovery": true,
          "dealerdirect/phpcodesniffer-composer-installer": true
      }
  },
  "require": {
    "wikimedia/deadlinkchecker": ">=v1.8",
    "neitanod/forceutf8": "dev-master",
    "wikimedia/utfnormal": "^4.0",
    "php-http/curl-client": "^2.2",
    "sentry/sdk": "^3.1",
    "influxdb/influxdb-php": "^1.15",
    "influxdata/influxdb-client-php": "^3.3",
    "guzzlehttp/guzzle": "^7.5",
    "phpmailer/phpmailer": "^6.8.0",
    "wikimedia/language-data": "^1.1"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/wikimedia/DeadlinkChecker"
    }
  ],
  "require-dev": {
    "mediawiki/mediawiki-codesniffer": "47.0.0",
    "php-parallel-lint/php-parallel-lint": "1.4.0",
    "php-parallel-lint/php-console-highlighter": "1.0.0"
  },
  "scripts": {
    "test": [
      "parallel-lint . --exclude vendor --exclude .git",
      "@phpcs"
    ],
    "phpcs": "phpcs -sp --cache",
    "fix": "phpcbf"
  }
}
